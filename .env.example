# Copy to .env locally. Never commit your real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Both flags must be explicitly enabled; demo mode is verified by MT5 at runtime.
FOREX_COPILOT_ENABLE_DEMO_ORDERS=false
FOREX_COPILOT_ENABLE_AUTO_DEMO=false

# Optional bot settings
AUTO_DEMO_SYMBOL=AUDUSD
AUTO_DEMO_TIMEFRAME=M15
AUTO_DEMO_VOLUME=0.01
AUTO_DEMO_POLL_SECONDS=30
